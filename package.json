{
  "name": "node-typescript-project-configurations",
  "version": "0.1.0",
  "private": true,
  "description": "Verified configurations for Node.js and TypeScript ESM projects",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.7"
  }
}
